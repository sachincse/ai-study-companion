# ---------------------------------------------------------------------------
# AI Study Companion - configuration
# Copy to .env and fill in what you use. Every key is optional except SECRET_KEY
# in production. You can also paste a key in Settings inside the app instead.
# Keep values bare: Docker Compose treats "KEY=   # note" as the literal value "# note".
# ---------------------------------------------------------------------------

# development | production | test
APP_ENV=development
# Required in production (the server refuses to start with the placeholder):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ALLOW_REGISTRATION=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# --- Chat model: pick ONE provider; keys for the others can stay empty ---------
# groq | gemini | openai | anthropic | xai | openrouter | mistral | deepseek | together |
# cerebras | sambanova | huggingface | nvidia | ollama | custom
LLM_PROVIDER=groq
# Leave empty to use the provider's default; the Settings page lists live models.
LLM_MODEL=

# Groq - https://console.groq.com/keys (free tier)
GROQ_API_KEY=
# Google Gemini - https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=
# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# xAI Grok - https://console.x.ai (keys start with xai-)
XAI_API_KEY=
# OpenRouter - https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Mistral - https://console.mistral.ai/api-keys (free tier)
MISTRAL_API_KEY=
# DeepSeek - https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Together AI - https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=
# Cerebras - https://cloud.cerebras.ai (trial credit after adding a payment method)
CEREBRAS_API_KEY=
# SambaNova - https://cloud.sambanova.ai (free tier)
SAMBANOVA_API_KEY=
# Hugging Face - https://huggingface.co/settings/tokens (free monthly credits)
HF_TOKEN=
# NVIDIA NIM - https://build.nvidia.com (free, rate-limited trial access)
NVIDIA_API_KEY=
# Local Ollama, no key needed (ollama pull qwen2.5:7b). Inside Docker Compose use http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
# For LLM_PROVIDER=custom (LM Studio, vLLM, LiteLLM...)
LLM_BASE_URL=
LLM_API_KEY=

# --- Embeddings (deployment-wide; re-index notes if you change it) ---------
# local (fastembed, offline, default) | openai | gemini | ollama
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=

# --- Retrieval -----------------------------------------------------------------
# chroma | memory
VECTOR_STORE=chroma
# ~500 tokens per chunk
CHUNK_SIZE_CHARS=2000
CHUNK_OVERLAP_CHARS=200
RETRIEVAL_TOP_K=6

# --- Lecture videos -------------------------------------------------------------
# Optional; without it the keyless yt-dlp search is used
YOUTUBE_API_KEY=
ENABLE_YTDLP_FALLBACK=true

# --- Limits ----------------------------------------------------------------------
MAX_UPLOAD_MB=25
AI_RATE_LIMIT_PER_MINUTE=30
LLM_TIMEOUT_SECONDS=120

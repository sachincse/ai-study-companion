# ---------------------------------------------------------------------------
# AI Study Companion - configuration
# Copy to .env and fill in what you use. Every key is optional except SECRET_KEY
# for production. You can also paste a key in Settings inside the app instead.
# ---------------------------------------------------------------------------

APP_ENV=development                 # development | production | test
SECRET_KEY=change-me-in-production  # python -c "import secrets; print(secrets.token_urlsafe(48))"
ALLOW_REGISTRATION=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# --- Chat model (pick ONE provider; keys for others can stay empty) ---------
# groq | gemini | openai | anthropic | xai | openrouter | mistral | deepseek | together | ollama | custom
LLM_PROVIDER=groq
# Leave empty to use the provider's default; the Settings page lists live models.
LLM_MODEL=

GROQ_API_KEY=                        # https://console.groq.com/keys        (free tier)
GEMINI_API_KEY=                      # https://aistudio.google.com/apikey   (free tier)
OPENAI_API_KEY=                      # https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=                   # https://console.anthropic.com/settings/keys
XAI_API_KEY=                         # https://console.x.ai  (keys start with xai-)
OPENROUTER_API_KEY=                  # https://openrouter.ai/keys
MISTRAL_API_KEY=                     # https://console.mistral.ai/api-keys
DEEPSEEK_API_KEY=                    # https://platform.deepseek.com/api_keys
TOGETHER_API_KEY=                    # https://api.together.xyz/settings/api-keys
OLLAMA_BASE_URL=http://localhost:11434   # local, no key needed (ollama pull qwen2.5:7b)
# For LLM_PROVIDER=custom (LM Studio, vLLM, LiteLLM...):
LLM_BASE_URL=
LLM_API_KEY=

# --- Embeddings (deployment-wide; re-index notes if you change it) ---------
# local (fastembed, offline, default) | openai | gemini | ollama
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=

# --- Retrieval ------------------------------------------------------------
VECTOR_STORE=chroma                  # chroma | memory
CHUNK_SIZE_CHARS=2000                # ~500 tokens
CHUNK_OVERLAP_CHARS=200
RETRIEVAL_TOP_K=6

# --- Lecture videos ----------------------------------------------------------
YOUTUBE_API_KEY=                     # optional; without it yt-dlp search is used
ENABLE_YTDLP_FALLBACK=true

# --- Limits ------------------------------------------------------------------
MAX_UPLOAD_MB=25
AI_RATE_LIMIT_PER_MINUTE=30
LLM_TIMEOUT_SECONDS=120
